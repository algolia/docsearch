---
import '@docsearch/css';

const searchLabel = Astro.locals.t('search.label');
---


<div id="docsearch" data-search-label={searchLabel}></div>

<script>
  /// <reference path="./virtual.d.ts" />
  import docsearch from '@docsearch/js/docsearch';
  import type { DocSearchInstance } from '@docsearch/js/docsearch';
  import config from 'virtual:docsearch-starlight-config';

  let instance: DocSearchInstance | undefined;
  let mountedContainer: HTMLElement | undefined;

  function unmountSearch() {
    instance?.destroy();
    instance = undefined;
    mountedContainer = undefined;
  }

  function mountSearch() {
    const container = document.querySelector<HTMLElement>('#docsearch');

    if (container && container === mountedContainer && instance) return;

    unmountSearch();
    if (!container) return;

    const searchLabel = container.dataset.searchLabel;

    instance = docsearch({
      ...config,
      container,
      placeholder: config.placeholder ?? searchLabel,
      translations: {
        ...config.translations,
        button: {
          buttonText: searchLabel,
          buttonAriaLabel: searchLabel,
          ...config.translations?.button,
        },
      },
    });
    mountedContainer = container;
  }

  // Astro keeps this script loaded across client-side navigation.
  document.addEventListener('astro:page-load', mountSearch);
  document.addEventListener('astro:before-swap', unmountSearch);
  mountSearch();

  // Release this module's listeners and instance before a hot replacement.
  if (import.meta.hot) {
    import.meta.hot.dispose(() => {
      document.removeEventListener('astro:page-load', mountSearch);
      document.removeEventListener('astro:before-swap', unmountSearch);
      unmountSearch();
    });
  }
</script>

<style>
  :global(:root),
  :global(:root[data-theme='dark']) {
    --docsearch-primary-color: var(--sl-color-text-accent);
    --docsearch-primary-dark-color: var(--sl-color-text-accent);
    --docsearch-soft-primary-color: var(--sl-color-accent-low);
    --docsearch-highlight-color: var(--sl-color-text-accent);
    --docsearch-focus-color: var(--sl-color-accent);
    --docsearch-text-color: var(--sl-color-text);
    --docsearch-secondary-text-color: var(--sl-color-gray-2);
    --docsearch-muted-color: var(--sl-color-gray-3);
    --docsearch-icon-color: var(--sl-color-gray-2);
    --docsearch-subtle-color: var(--sl-color-gray-5);
    --docsearch-background-color: var(--sl-color-gray-6);
    --docsearch-container-background: var(--sl-color-backdrop-overlay);
    --docsearch-search-button-background: var(--sl-color-bg);
    --docsearch-search-button-text-color: var(--sl-color-gray-2);
    --docsearch-modal-background: var(--sl-color-bg);
    --docsearch-modal-shadow: var(--sl-shadow-lg);
    --docsearch-searchbox-background: var(--sl-color-gray-6);
    --docsearch-searchbox-focus-background: var(--sl-color-bg);
    --docsearch-popover-background: var(--sl-color-bg);
    --docsearch-popover-shadow: var(--sl-shadow-md);
    --docsearch-popover-arrow-color: var(--sl-color-hairline-light);
    --docsearch-hit-color: var(--sl-color-text);
    --docsearch-hit-background: var(--sl-color-bg);
    --docsearch-hit-focus-background: var(--sl-color-gray-6);
    --docsearch-hit-highlight-color: var(--sl-color-accent-low);
    --docsearch-key-background: var(--sl-color-gray-6);
    --docsearch-key-color: var(--sl-color-gray-2);
    --docsearch-footer-background: var(--sl-color-bg);
    --docsearch-footer-shadow: 0 -1px 0 0 var(--sl-color-hairline-light);
  }

  #docsearch {
    min-width: 0;
    width: 100%;
    max-width: 22rem;
  }

  #docsearch :global(.DocSearch-Button) {
    box-sizing: border-box;
    width: 100%;
    margin: 0;
  }

  #docsearch :global(.DocSearch-Button:focus-visible) {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 3px;
  }

  @media (width < 50rem) {
    #docsearch {
      width: auto;
    }
  }
</style>