---
import '@docsearch/css';

const searchLabel = Astro.locals.t('search.label');
---


<div id="docsearch" data-search-label={searchLabel}></div>
<div id="docsearch-sidepanel-button"></div>

<script>
  // oxlint-disable-next-line typescript/triple-slash-reference -- Include the packaged ambient virtual-module declaration without a runtime import.
  /// <reference path="./virtual.d.ts" />
  import docsearch from '@docsearch/js/docsearch';
  import type { DocSearchInstance, DocSearchProps } from '@docsearch/js/docsearch';
  import type { SidepanelInstance } from '@docsearch/sidepanel-js';
  import config from 'virtual:docsearch-starlight-config';

  const { askAi, sidePanel, ...keywordConfig } = config;
  type AskAiConfig = NonNullable<typeof askAi>;

  let instance: DocSearchInstance | undefined;
  let panel: SidepanelInstance | undefined;
  let mountedContainer: HTMLElement | undefined;
  // Lets a pending Ask AI import detect that it was unmounted or superseded.
  let mountId = 0;

  function unmountSearch() {
    mountId++;
    instance?.destroy();
    panel?.destroy();
    instance = undefined;
    panel = undefined;
    mountedContainer = undefined;
  }

  // Lazy-loaded so keyword-only sites don't ship the Ask AI bundle.
  async function createAskAiSearch(
    props: DocSearchProps,
    askAiConfig: AskAiConfig
  ): Promise<DocSearchInstance> {
    try {
      const { default: docsearchAi } = await import('@docsearch/js');
      return docsearchAi({
        ...props,
        askAi: askAiConfig,
        // Without a mounted panel, Ask AI stays in the modal.
        interceptAskAiEvent: (initialMessage) => {
          if (!panel) return false;
          instance?.close();
          panel.open(initialMessage);
          return true;
        },
        onOpen: () => panel?.close(),
      });
    } catch (error) {
      // oxlint-disable-next-line no-console -- Explain why Ask AI is missing while keyword search keeps working.
      console.error('DocSearch Ask AI failed to load. Using keyword search.', error);
      return docsearch(props);
    }
  }

  async function createSidePanel(
    container: HTMLElement,
    askAiConfig: AskAiConfig
  ): Promise<SidepanelInstance | undefined> {
    try {
      const [{ default: sidepanel }] = await Promise.all([
        import('@docsearch/sidepanel-js'),
        import('@docsearch/css/dist/sidepanel.css'),
      ]);
      const agent =
        typeof askAiConfig === 'string' ? { agentId: askAiConfig } : askAiConfig;
      const {
        keyboardShortcuts,
        // A centred Starlight search leaves no natural spot for an inline button.
        buttonVariant = 'floating',
        ...panelOptions
      } = typeof sidePanel === 'object' ? sidePanel : {};

      return sidepanel({
        container,
        agentId: agent.agentId,
        appId: agent.appId ?? config.appId,
        apiKey: agent.apiKey ?? config.apiKey,
        indices: agent.indices,
        searchParameters: agent.searchParameters,
        keyboardShortcuts,
        button:
          buttonVariant === 'inline'
            ? { variant: 'inline', translations: { buttonText: '' } }
            : { variant: 'floating' },
        panel: {
          pushSelector: '.main-frame',
          suggestedQuestions: agent.suggestedQuestions,
          ...panelOptions,
        },
        onOpen: () => instance?.close(),
      });
    } catch (error) {
      // oxlint-disable-next-line no-console -- Explain why the side panel is missing while search keeps working.
      console.error('DocSearch side panel failed to load.', error);
      return undefined;
    }
  }

  async function mountSearch() {
    const container = document.querySelector<HTMLElement>('#docsearch');

    if (container && container === mountedContainer && instance) return;

    unmountSearch();
    if (!container) return;

    const currentMountId = mountId;
    const searchLabel = container.dataset.searchLabel;
    const props: DocSearchProps = {
      ...keywordConfig,
      container,
      placeholder: config.placeholder ?? searchLabel,
      translations: {
        ...config.translations,
        button: {
          buttonText: searchLabel,
          buttonAriaLabel: searchLabel,
          ...config.translations?.button,
        },
      },
    };

    const created = askAi
      ? await createAskAiSearch(props, askAi)
      : docsearch(props);

    if (currentMountId !== mountId) {
      created.destroy();
      return;
    }

    instance = created;
    mountedContainer = container;

    const panelContainer = document.querySelector<HTMLElement>(
      '#docsearch-sidepanel-button'
    );
    if (!askAi || !sidePanel || !panelContainer) return;

    const createdPanel = await createSidePanel(panelContainer, askAi);
    if (currentMountId !== mountId) {
      createdPanel?.destroy();
      return;
    }
    panel = createdPanel;
  }

  // Astro keeps this script loaded across client-side navigation.
  document.addEventListener('astro:page-load', mountSearch);
  document.addEventListener('astro:before-swap', unmountSearch);
  mountSearch();

  // Release this module's listeners and instance before a hot replacement.
  if (import.meta.hot) {
    import.meta.hot.dispose(() => {
      document.removeEventListener('astro:page-load', mountSearch);
      document.removeEventListener('astro:before-swap', unmountSearch);
      unmountSearch();
    });
  }
</script>

<style>
  :global(:root),
  :global(:root[data-theme='dark']) {
    --docsearch-primary-color: var(--sl-color-text-accent);
    --docsearch-primary-dark-color: var(--sl-color-text-accent);
    --docsearch-soft-primary-color: var(--sl-color-accent-low);
    --docsearch-highlight-color: var(--sl-color-text-accent);
    --docsearch-focus-color: var(--sl-color-accent);
    --docsearch-text-color: var(--sl-color-text);
    --docsearch-secondary-text-color: var(--sl-color-gray-2);
    --docsearch-muted-color: var(--sl-color-gray-3);
    --docsearch-icon-color: var(--sl-color-gray-2);
    --docsearch-subtle-color: var(--sl-color-gray-5);
    --docsearch-background-color: var(--sl-color-gray-6);
    --docsearch-container-background: var(--sl-color-backdrop-overlay);
    --docsearch-search-button-background: var(--sl-color-bg);
    --docsearch-search-button-text-color: var(--sl-color-gray-2);
    --docsearch-modal-background: var(--sl-color-bg);
    --docsearch-modal-shadow: var(--sl-shadow-lg);
    --docsearch-searchbox-background: var(--sl-color-gray-6);
    --docsearch-searchbox-focus-background: var(--sl-color-bg);
    --docsearch-popover-background: var(--sl-color-bg);
    --docsearch-popover-shadow: var(--sl-shadow-md);
    --docsearch-popover-arrow-color: var(--sl-color-hairline-light);
    --docsearch-hit-color: var(--sl-color-text);
    --docsearch-hit-background: var(--sl-color-bg);
    --docsearch-hit-focus-background: var(--sl-color-gray-6);
    --docsearch-hit-highlight-color: var(--sl-color-accent-low);
    --docsearch-key-background: var(--sl-color-gray-6);
    --docsearch-key-color: var(--sl-color-gray-2);
    --docsearch-footer-background: var(--sl-color-bg);
    --docsearch-footer-shadow: 0 -1px 0 0 var(--sl-color-hairline-light);
  }

  #docsearch {
    min-width: 0;
    width: 100%;
    max-width: 22rem;
  }

  #docsearch :global(.DocSearch-Button) {
    box-sizing: border-box;
    width: 100%;
    margin: 0;
  }

  #docsearch :global(.DocSearch-Button:focus-visible) {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 3px;
  }

  #docsearch-sidepanel-button {
    display: flex;
    flex-shrink: 0;
    align-items: center;
  }

  #docsearch-sidepanel-button:not(:empty) {
    margin-inline-start: 0.5rem;
  }

  @media (width < 50rem) {
    #docsearch {
      width: auto;
    }
  }
</style>