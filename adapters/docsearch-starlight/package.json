{
  "name": "@docsearch/starlight-adapter",
  "version": "5.1.2",
  "description": "Algolia DocSearch integration for Astro Starlight.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/algolia/docsearch.git",
    "directory": "adapters/docsearch-starlight"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "files": [
    "lib"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./Search.astro": "./lib/Search.astro"
  },
  "scripts": {
    "build": "tsdown",
    "watch": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "typecheck:astro": "astro check --tsconfig ./tsconfig.astro.json"
  },
  "dependencies": {
    "@docsearch/js": "5.1.2",
    "@docsearch/css": "5.1.2"
  },
  "peerDependencies": {
    "@astrojs/starlight": "^0.42.7",
    "astro": "^7.2.10"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "tsdown": "catalog:dev",
    "typescript": "5.7.3"
  }
}
